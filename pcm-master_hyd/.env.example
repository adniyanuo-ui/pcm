# 复制为 .env.local 后填写。不要提交 .env.local。
PCM_ENV=local
DJANGO_SECRET_KEY=replace-with-a-long-random-local-value
PCM_PUBLIC_URL=http://127.0.0.1:5174

# 在线大模型：至少配置当前准备使用的一家。
QWEN_API_KEY=
DEEPSEEK_API_KEY=
DOUBAO_API_KEY=

# 阿里云智能语音交互。AccessKey只存在后端，不得放入浏览器。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_NLS_APPKEY=
ALIYUN_NLS_REGION=cn-shanghai
ALIYUN_NLS_GATEWAY=wss://nls-gateway.cn-shanghai.aliyuncs.com/ws/v1
